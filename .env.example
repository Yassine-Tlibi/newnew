# Database
DATABASE_URL="postgresql://user:password@localhost:5432/tn_game_price_finder?schema=public"

# Redis (for queue workers)
REDIS_URL="redis://localhost:6379"

# Search Provider (optional - can work without it using direct store crawls)
SEARCH_PROVIDER_API_KEY=""
SEARCH_PROVIDER_TYPE="serpapi" # serpapi, brave, google_cse, or leave empty

# Allowed domains for redirect (comma-separated)
ALLOWED_DOMAINS="gameworld.tn,skymil-informatique.com,sbsinformatique.com,mytek.tn,bestbuytunisie.tn"

# App settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin token (optional, for admin API routes)
ADMIN_TOKEN=""
